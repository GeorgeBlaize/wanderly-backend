NODE_ENV=development
PORT=5000

# Postgres connection string (Neon, Supabase, Render, or local)
DATABASE_URL="postgresql://user:password@host:5432/wanderly?sslmode=require"

# Long random string used to sign JWTs
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN=7d

# Public URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials
# with authorized redirect URI: {SERVER_URL}/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
